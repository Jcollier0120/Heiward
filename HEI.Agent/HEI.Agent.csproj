<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Windows only: WIC, Task Scheduler, the Recycle Bin, the Hexagon NPU. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The command is "hei"; Task Manager and file properties show the product name. -->
    <AssemblyName>hei</AssemblyName>
    <!-- Heiward's own version, as Apps & Features and the version option show it. Directory.Build.props's is Video Duplicate Finder's. -->
    <VersionPrefix>1.7.2</VersionPrefix>
    <Product>Heiward</Product>
    <!-- The shield and leaf (make-icon.ps1 renders it from wwwroot\favicon.svg): the exe, its shortcuts and Apps & Features show it. -->
    <ApplicationIcon>heiward.ico</ApplicationIcon>
    <AssemblyTitle>Heiward</AssemblyTitle>
    <Description>Finds duplicate photos and videos, and stale developer files, for you to review.</Description>
    <RootNamespace>HEI.Agent</RootNamespace>
    <!-- The review page's files are compiled in: one exe, nothing to serve from disk. -->
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
    <IsWebConfigTransformDisabled>true</IsWebConfigTransformDisabled>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HEI.Agent.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HEI.Core\HEI.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.9" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="wwwroot\**" LogicalName="wwwroot/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
