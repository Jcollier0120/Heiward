<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Windows only: WIC, Task Scheduler, the Recycle Bin, the Hexagon NPU. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The command is "hei"; Task Manager and file properties show the product name. -->
    <AssemblyName>hei</AssemblyName>
    <!-- Heiward's own version, as Apps & Features and the version option show it. Directory.Build.props's is Video Duplicate Finder's. -->
    <VersionPrefix>1.9.113</VersionPrefix>
    <Product>Heiward</Product>
    <!-- The shield and leaf (make-icon.ps1 renders it from wwwroot\favicon.svg): the exe, its shortcuts and Apps & Features show it. -->
    <ApplicationIcon>heiward.ico</ApplicationIcon>
    <AssemblyTitle>Heiward</AssemblyTitle>
    <Description>Finds duplicate photos and videos, and stale developer files, for you to review.</Description>
    <RootNamespace>HEI.Agent</RootNamespace>
    <!-- The review page's files are compiled in: one exe, nothing to serve from disk. -->
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
    <IsWebConfigTransformDisabled>true</IsWebConfigTransformDisabled>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HEI.Agent.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HEI.Core\HEI.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.9" />
    <!-- An update's signature and its timestamp (Authenticode.cs): the shared frameworks carry it, but no reference to it. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="wwwroot\**" LogicalName="wwwroot/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- The GNU AGPL's text and the third-party notices (tools\notices.ps1 writes them), kept with every copy: in hei.exe
       for About and the install (LicenseTexts.cs), and beside it in the build output and a publish, outside the single file. -->
  <ItemGroup>
    <EmbeddedResource Include="..\LICENSE" LogicalName="LICENSE.txt" Type="Non-Resx" WithCulture="false" />
    <EmbeddedResource Include="..\THIRD-PARTY-NOTICES.txt" LogicalName="THIRD-PARTY-NOTICES.txt" Type="Non-Resx" WithCulture="false" />
    <None Include="..\LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Include="..\THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <!-- Heiward.exe (HEI.Launcher), written beside hei.exe at install: what Windows' Startup apps lists (Startup.cs). A
       release passes its signed build (-p:HeiwardLauncher=...); any other build embeds the project's own. -->
  <ItemGroup Condition="'$(HeiwardLauncher)' == ''">
    <ProjectReference Include="..\HEI.Launcher\HEI.Launcher.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true"
      GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained;PublishSingleFile;IncludeNativeLibrariesForSelfExtract;EnableCompressionInSingleFile"
      OutputItemType="HeiwardLauncherBuilt" />
  </ItemGroup>
  <Target Name="EmbedHeiwardLauncher" AfterTargets="ResolveProjectReferences">
    <ItemGroup>
      <EmbeddedResource Include="$(HeiwardLauncher)" Condition="'$(HeiwardLauncher)' != ''" LogicalName="Heiward.exe" Type="Non-Resx" WithCulture="false" />
      <EmbeddedResource Include="@(HeiwardLauncherBuilt)" Condition="'$(HeiwardLauncher)' == ''" LogicalName="Heiward.exe" Type="Non-Resx" WithCulture="false" />
    </ItemGroup>
  </Target>

</Project>
