<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.7.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <!-- A JavaScript engine, for the tests only: TrailTests runs the page's trail.js (Back and Forward) as it is, and
         PageDialogTests the page's own questions; its parser (Acornima) reads the scripts for the browser's windows. -->
    <PackageReference Include="Jint" Version="4.16.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HEI.Agent\HEI.Agent.csproj" />
    <ProjectReference Include="..\HEI.StoreSubmit\HEI.StoreSubmit.csproj" />
  </ItemGroup>

  <!-- Partner Center's JSON, as its submission API answers, for StoreSubmitTests. -->
  <ItemGroup>
    <None Include="PartnerCenter\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
